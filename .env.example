DB_HOST=localhost
DB_PORT=1433
DB_NAME=RVTTicket
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-local-password
SERVER_PORT=8080
# Chỉ dùng khi chưa có tài khoản admin. Bản cục bộ mặc định 123456; khi deploy BẮT BUỘC đặt mật khẩu mạnh khác.
# Sau khi tạo, đổi mật khẩu tại /admin/tai-khoan; không reset khi khởi động lại.
ADMIN_PASSWORD=123456

# VNPay. .env is a reference file; Spring does not load it automatically.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PUBLIC_BASE_URL=
VNPAY_RETURN_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VNPAY_QUERY_ENABLED=false
RVT_ALLOW_DEMO_PAYMENT=false

# Khi deploy (Render): PORT do Render cấp; nên đặt thêm
# THYMELEAF_CACHE=true
# DB_POOL_MAX=5
# DB_POOL_MIN_IDLE=1
# Chỉ bật khi IPN chưa đăng ký và máy chủ không gọi được querydr (vd. host ở nước ngoài):
# trang Return có chữ ký VNPay sẽ xác nhận vé với cùng các kiểm tra như IPN.
VNPAY_RETURN_SETTLES=false
